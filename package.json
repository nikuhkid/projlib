{
  "name": "projlib",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "browser:init": "node server/start.mjs --init",
    "browser:host": "node server/start.mjs",
    "browser:stop": "node server/start.mjs --stop",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "miniflare": "5.20261101.0-beta",
    "wrangler": "4.156.1"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "playwright": "1.64.1",
    "ws": "8.22.1"
  }
}
