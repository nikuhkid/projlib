{
  "name": "projlib",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:rewrite": "node scripts/build-rewrite.mjs",
    "pretest": "npm run build:rewrite",
    "pretest:browser": "npm run build:rewrite",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "browser:init": "node server/start.mjs --init",
    "browser:host": "node server/start.mjs",
    "browser:stop": "node server/start.mjs --stop",
    "worker:dev": "npm run build:rewrite && wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npm run build:rewrite && wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta",
    "wrangler": "4.156.1"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/scramjet": "1.1.0",
    "ipaddr.js": "2.5.0",
    "playwright": "1.64.1",
    "tough-cookie": "6.0.2",
    "ws": "8.22.1"
  }
}
